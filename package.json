{
  "name": "ilovepawn-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Frontend monorepo (web + mobile) for the ilovepawn chess platform",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.mjs",
    "pre-push": "node scripts/pre-push.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "simple-git-hooks": "^2.13.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
