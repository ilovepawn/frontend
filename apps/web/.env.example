# Base URL of the ilovepawn backend API gateway (Arbiter).
# Used by @ilovepawn/api ApiClient for all authenticated requests.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Keycloak instance details. The frontend talks directly to Keycloak via
# keycloak-js (PKCE), then sends Keycloak-issued JWTs to Arbiter as
# Authorization: Bearer.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081
NEXT_PUBLIC_KEYCLOAK_REALM=ilovepawn
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=arbiter
