{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm check)",
      "Bash(pnpm format)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm biome:*)",
      "Bash(pnpm --filter:*)",
      "Bash(node:*)",
      "Bash(tsc:*)",
      "Bash(corepack:*)",
      "Bash(npm -v)",
      "Bash(npm view:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git checkout)",
      "Bash(git checkout:*)",
      "Bash(git switch)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin:*)",
      "Bash(git push -u origin:*)",
      "Bash(git pull)",
      "Bash(git pull:*)",
      "Bash(git fetch)",
      "Bash(git fetch:*)",
      "Bash(git remote)",
      "Bash(git remote:*)",
      "Bash(git ls-remote:*)",
      "Bash(git stash)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(git config --get:*)",
      "Bash(git init)",
      "Bash(git init:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Bash(gh auth status)",
      "Bash(mkdir -p:*)",
      "Bash(rm:*)",
      "Bash(echo:*)",
      "Bash(date:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf *)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase -i:*)",
      "Bash(git rebase --interactive:*)",
      "Bash(git config --global:*)",
      "Bash(git config --system:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)",
      "Bash(wget:* | sh)",
      "Bash(wget:* | bash)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-checkpoint.sh\""
          }
        ]
      }
    ]
  }
}
